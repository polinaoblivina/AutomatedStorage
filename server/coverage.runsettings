<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[ServerAutomatedStorage.*]*</Include>
          <Exclude>[*Tests]*</Exclude>
          <ExcludeByFile>**/Migrations/**,**/Persistence/Configurations/**,**/Program.cs,**/DependencyInjection.cs,**/AuthenticationSetup.cs,**/AuthorizationSetup.cs,**/OpenApi/**</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
